QWidget {
    background-color: #040608;
    color: #eef5fb;
    font-size: 14px;
    font-family: "Segoe UI Variable Text", "Bahnschrift", "Segoe UI";
}

QToolTip {
    background-color: rgba(4, 6, 9, 246);
    color: #f6fbff;
    border: 1px solid rgba(148, 224, 255, 0.26);
    border-radius: 10px;
    padding: 8px 10px;
}

#windowRoot {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #030507,
        stop: 0.28 #05080c,
        stop: 0.62 #080d13,
        stop: 1 #0b1018
    );
}

#titleBar {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(8, 14, 20, 0.97),
        stop: 0.52 rgba(10, 16, 24, 0.95),
        stop: 1 rgba(6, 12, 18, 0.99)
    );
    border: 1px solid rgba(149, 223, 255, 0.16);
    border-radius: 20px;
}

#titleBadge {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #45b8ff,
        stop: 1 #6ae3d7
    );
    color: #04101c;
    border-radius: 14px;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
    font-size: 16px;
    qproperty-alignment: AlignCenter;
}

#windowTitleLabel {
    color: #f8fcff;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
    font-size: 15px;
}

#windowStatusLabel {
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
}

#titleBarButton,
#titleBarCloseButton {
    min-width: 38px;
    min-height: 32px;
    max-width: 38px;
    max-height: 32px;
    border-radius: 11px;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
    font-size: 13px;
}

#titleBarButton {
    background: rgba(20, 39, 57, 0.92);
    border: 1px solid rgba(149, 223, 255, 0.12);
    color: #eef5fb;
}

#titleBarButton:hover {
    background: rgba(35, 66, 94, 0.98);
    border: 1px solid rgba(149, 223, 255, 0.28);
}

#titleBarButton:pressed {
    background: rgba(52, 96, 136, 0.98);
}

#titleBarCloseButton {
    background: rgba(77, 28, 40, 0.92);
    border: 1px solid rgba(255, 170, 185, 0.12);
    color: #fff2f4;
}

#titleBarCloseButton:hover {
    background: rgba(136, 45, 64, 0.98);
    border: 1px solid rgba(255, 188, 199, 0.30);
}

#titleBarCloseButton:pressed {
    background: rgba(170, 56, 79, 0.98);
}

#backdropOrbA,
#backdropOrbB {
    border-radius: 999px;
    border: none;
}

#backdropOrbA {
    background: qradialgradient(
        cx: 0.42, cy: 0.38, radius: 0.86,
        fx: 0.42, fy: 0.38,
        stop: 0 rgba(94, 200, 255, 0.08),
        stop: 0.42 rgba(35, 132, 194, 0.03),
        stop: 1 rgba(0, 0, 0, 0.0)
    );
}

#backdropOrbB {
    background: qradialgradient(
        cx: 0.56, cy: 0.44, radius: 0.88,
        fx: 0.56, fy: 0.44,
        stop: 0 rgba(255, 102, 153, 0.05),
        stop: 0.45 rgba(135, 88, 214, 0.02),
        stop: 1 rgba(0, 0, 0, 0.0)
    );
}

#navSidebar {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(3, 5, 8, 0.96),
        stop: 1 rgba(2, 4, 6, 0.94)
    );
    border: 1px solid rgba(190, 235, 255, 0.18);
    border-radius: 22px;
    padding: 10px;
    outline: none;
}

#navSidebar::item {
    padding: 15px 17px;
    margin: 3px 0;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-left: 3px solid rgba(255, 255, 255, 0.07);
    color: #ffffff;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
    font-size: 19px;
    font-weight: 900;
    letter-spacing: 0.9px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(255, 255, 255, 0.028),
        stop: 1 rgba(255, 255, 255, 0.012)
    );
}

#navSidebar[compactMode="true"]::item {
    padding: 9px 12px;
    margin: 2px 0;
}

#navSidebar::item:selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(60, 188, 238, 0.99),
        stop: 0.52 rgba(76, 205, 214, 0.99),
        stop: 1 rgba(108, 152, 255, 0.98)
    );
    color: #ffffff;
    border: 1px solid rgba(234, 249, 255, 0.72);
    border-left: 4px solid #ffffff;
    font-weight: 900;
    font-size: 20px;
}

#navSidebar::item:hover:!selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(67, 117, 156, 0.62),
        stop: 1 rgba(37, 80, 120, 0.38)
    );
    border: 1px solid rgba(188, 233, 255, 0.36);
    border-left: 4px solid rgba(215, 243, 255, 0.66);
    color: #ffffff;
    font-weight: 900;
}

#contentPanel {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(3, 5, 8, 0.94),
        stop: 0.45 rgba(4, 6, 9, 0.92),
        stop: 1 rgba(2, 4, 6, 0.96)
    );
    border: 1px solid rgba(150, 224, 255, 0.14);
    border-radius: 28px;
}

#headerTitle {
    font-size: 30px;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
    font-weight: 600;
    color: #f7fbff;
    letter-spacing: 1px;
    background: transparent;
}

#headerSubtitle {
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 5px;
    background: transparent;
}

#searchField {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(4, 6, 9, 0.98),
        stop: 1 rgba(7, 10, 14, 0.98)
    );
    border: 1px solid rgba(149, 223, 255, 0.15);
    border-radius: 16px;
    padding: 12px 14px;
    selection-background-color: rgba(47, 166, 196, 0.88);
}

#searchField:hover {
    border: 1px solid rgba(129, 215, 255, 0.28);
}

#searchField:focus {
    border: 1px solid rgba(96, 204, 255, 0.78);
    background-color: rgba(8, 12, 17, 0.99);
}

#searchField[echoMode="0"] {
    color: #f3f8fd;
}

#pageStack,
#perfStack {
    border: none;
    background: transparent;
}

#metricCard {
    border-radius: 18px;
    padding: 13px 18px;
    color: #f6fbff;
    border: 1px solid rgba(160, 225, 255, 0.14);
    font-size: 15px;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
}

#metricCard[metricRole="cpu"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(24, 88, 136, 0.99),
        stop: 1 rgba(10, 32, 52, 0.99)
    );
    border: 1px solid rgba(194, 243, 255, 0.90);
}

#metricCard[metricRole="memory"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(16, 98, 78, 0.99),
        stop: 1 rgba(7, 32, 24, 0.99)
    );
    border: 1px solid rgba(196, 255, 229, 0.88);
}

#metricCard[metricRole="disk"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(132, 95, 22, 0.99),
        stop: 1 rgba(42, 28, 8, 0.99)
    );
    border: 1px solid rgba(255, 236, 176, 0.90);
}

#metricCard[metricRole="network"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(8, 4, 9, 0.97),
        stop: 1 rgba(12, 5, 12, 0.96)
    );
    border: 1px solid rgba(255, 129, 216, 0.24);
}

#metricCard[metricRole="gpu"],
#metricCard[metricRole="temperature"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(134, 34, 58, 0.99),
        stop: 1 rgba(40, 12, 18, 0.99)
    );
    border: 1px solid rgba(255, 210, 221, 0.90);
}

#metricCard[metricRole="serviceRunning"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(14, 92, 70, 0.99),
        stop: 1 rgba(6, 28, 18, 0.99)
    );
    border: 1px solid rgba(194, 255, 228, 0.86);
}

#metricCard[metricRole="serviceStopped"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(112, 72, 18, 0.99),
        stop: 1 rgba(34, 19, 7, 0.99)
    );
    border: 1px solid rgba(255, 232, 182, 0.86);
}

#processTree {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(2, 4, 6, 0.94),
        stop: 1 rgba(1, 3, 5, 0.90)
    );
    alternate-background-color: rgba(6, 10, 15, 0.78);
    border: 1px solid rgba(149, 223, 255, 0.13);
    border-radius: 20px;
    padding: 10px;
    outline: none;
    color: #eef6fc;
}

#processTree::item {
    padding: 10px 8px;
    border-radius: 10px;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Text", "Segoe UI";
    font-size: 14px;
    font-weight: 700;
}

#processTree[compactMode="true"]::item {
    padding: 6px 6px;
}

#processTree::item:hover {
    background-color: rgba(79, 141, 177, 0.14);
}

#processTree::item:selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(68, 168, 224, 0.99),
        stop: 0.62 rgba(76, 210, 201, 0.97),
        stop: 1 rgba(108, 172, 255, 0.94)
    );
    color: #ffffff;
    border: 1px solid rgba(205, 241, 255, 0.34);
}

QSplitter::handle {
    background: rgba(149, 223, 255, 0.05);
    border-radius: 4px;
}

QSplitter::handle:hover {
    background: rgba(149, 223, 255, 0.15);
}

#sidePanel {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(4, 6, 9, 0.96),
        stop: 1 rgba(2, 4, 6, 0.94)
    );
    border: 1px solid rgba(149, 223, 255, 0.12);
    border-radius: 20px;
}

#sidePanel[protectedState="true"] {
    border: 1px solid rgba(232, 113, 132, 0.52);
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(35, 19, 27, 0.96),
        stop: 1 rgba(24, 14, 20, 0.92)
    );
}

#sidePanelScroll,
#sidePanelScroll > QWidget {
    background: transparent;
    border: none;
}

#sidePanelTitle {
    color: #f7fbff;
    font-size: 24px;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
    font-weight: 900;
}

#protectedBadge {
    background: rgba(230, 92, 114, 0.30);
    color: #ffdce4;
    border: 1px solid rgba(255, 137, 160, 0.74);
    border-radius: 11px;
    padding: 4px 11px;
    font-size: 11px;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
    letter-spacing: 1px;
}

#sidePanelSubtitle {
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
}

#sideKey,
#detailKey {
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
}

#sideValue,
#detailValue {
    color: #ffffff;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
    font-size: 15px;
    font-weight: 900;
    padding-top: 2px;
}

#perfScroll,
#perfRoot {
    background: transparent;
}

QScrollArea#perfScroll {
    border: 1px solid rgba(149, 223, 255, 0.10);
    border-radius: 20px;
    background-color: rgba(3, 5, 8, 0.34);
}

#perfSidebar {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(3, 5, 8, 0.94),
        stop: 1 rgba(2, 4, 6, 0.88)
    );
    border: 1px solid rgba(149, 223, 255, 0.12);
    border-radius: 20px;
    padding: 10px;
    outline: none;
}

#perfSidebar::item {
    padding: 11px 13px;
    margin: 4px 0;
    border-radius: 12px;
    color: #ffffff;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0.6px;
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-left: 3px solid rgba(255, 255, 255, 0.06);
}

#perfSidebar[compactMode="true"]::item {
    padding: 8px 10px;
    margin: 2px 0;
}

#perfSidebar::item:selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(86, 194, 255, 0.99),
        stop: 0.62 rgba(98, 232, 222, 0.98),
        stop: 1 rgba(132, 191, 255, 0.96)
    );
    color: #ffffff;
    border: 1px solid rgba(229, 248, 255, 0.52);
    border-left: 4px solid #ffffff;
    font-size: 18px;
    font-weight: 900;
}

#perfSidebar::item:hover:!selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(67, 117, 156, 0.34),
        stop: 1 rgba(37, 80, 120, 0.18)
    );
    border: 1px solid rgba(206, 241, 255, 0.18);
    border-left: 4px solid rgba(227, 247, 255, 0.42);
    color: #ffffff;
    font-weight: 900;
}

#perfCard,
#detailSection {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(4, 6, 9, 0.97),
        stop: 0.55 rgba(3, 5, 8, 0.95),
        stop: 1 rgba(2, 4, 6, 0.98)
    );
    border: 1px solid rgba(150, 223, 255, 0.16);
    border-radius: 24px;
}

#perfCard:hover,
#detailSection:hover {
    border: 1px solid rgba(168, 232, 255, 0.28);
}

#perfCard[valueHot="true"] {
    border: 1px solid rgba(227, 245, 255, 0.38);
}

#perfCard[metricRole="cpu"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(14, 58, 90, 0.99),
        stop: 1 rgba(6, 16, 26, 0.99)
    );
    border: 1px solid rgba(201, 244, 255, 0.92);
}

#perfCard[metricRole="memory"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(10, 62, 48, 0.99),
        stop: 1 rgba(5, 16, 12, 0.99)
    );
    border: 1px solid rgba(201, 255, 231, 0.90);
}

#perfCard[metricRole="disk"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(86, 61, 14, 0.99),
        stop: 1 rgba(24, 16, 5, 0.99)
    );
    border: 1px solid rgba(255, 236, 188, 0.92);
}

#perfCard[metricRole="network"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(74, 18, 76, 0.99),
        stop: 1 rgba(18, 6, 20, 0.99)
    );
    border: 1px solid rgba(255, 196, 240, 0.84);
}

#perfCard[metricRole="gpu"],
#perfCard[metricRole="temperature"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(90, 18, 34, 0.99),
        stop: 1 rgba(18, 5, 8, 0.99)
    );
    border: 1px solid rgba(255, 217, 227, 0.92);
}

#perfCardTitle,
#detailSectionTitle {
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
    font-size: 15px;
    letter-spacing: 1.1px;
    font-weight: 900;
}

#perfCardTitle[metricRole="cpu"],
#detailSectionTitle[metricRole="cpu"] { color: #d0f5ff; }
#perfCardTitle[metricRole="memory"],
#detailSectionTitle[metricRole="memory"] { color: #d4ffe9; }
#perfCardTitle[metricRole="disk"],
#detailSectionTitle[metricRole="disk"] { color: #fff0c6; }
#perfCardTitle[metricRole="network"],
#detailSectionTitle[metricRole="network"] { color: #ffc7f0; }
#perfCardTitle[metricRole="gpu"],
#detailSectionTitle[metricRole="gpu"],
#perfCardTitle[metricRole="temperature"],
#detailSectionTitle[metricRole="temperature"] { color: #ffd7e2; }
#detailSectionTitle {
    color: #ffffff;
    font-weight: 900;
}

#perfCardValue {
    color: #f8fcff;
    font-family: "Cascadia Code SemiBold", "Cascadia Mono", "Consolas";
    font-size: 34px;
}

#perfCardSubtitle {
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
}

#perfGraphCaption {
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    padding-top: 2px;
}

#perfProgress {
    border: none;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    min-height: 10px;
}

#perfProgress[metricRole="cpu"]::chunk {
    border-radius: 8px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #7ac8ff,
        stop: 1 #d4fbff
    );
}

#perfProgress[metricRole="memory"]::chunk {
    border-radius: 8px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #65e9bc,
        stop: 1 #d9fff0
    );
}

#perfProgress[metricRole="disk"]::chunk {
    border-radius: 8px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #ffd47b,
        stop: 1 #fff2ca
    );
}

#perfProgress[metricRole="network"]::chunk {
    border-radius: 8px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #f59bff,
        stop: 1 #ffd0f3
    );
}

#perfProgress[metricRole="gpu"]::chunk,
#perfProgress[metricRole="temperature"]::chunk {
    border-radius: 8px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #ffafbc,
        stop: 1 #ffe0bb
    );
}

QHeaderView::section {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(5, 8, 11, 0.98),
        stop: 1 rgba(3, 5, 8, 0.99)
    );
    color: #f3f8fd;
    border: none;
    border-right: 1px solid rgba(149, 223, 255, 0.08);
    border-bottom: 1px solid rgba(149, 223, 255, 0.08);
    padding: 12px 10px;
    font-size: 13px;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
}

QHeaderView[compactMode="true"]::section {
    padding: 8px 8px;
    font-size: 12px;
}

QMenu {
    background-color: rgba(4, 6, 9, 0.99);
    border: 1px solid rgba(149, 223, 255, 0.18);
    border-radius: 14px;
    padding: 8px;
}

QMenu::item {
    padding: 10px 18px 10px 12px;
    margin: 2px 0;
    border-radius: 10px;
    color: #eef6fc;
}

QMenu::item:selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(45, 142, 193, 0.98),
        stop: 0.62 rgba(60, 188, 183, 0.94),
        stop: 1 rgba(89, 151, 255, 0.90)
    );
    color: #ffffff;
}

QMenu::item:disabled {
    color: rgba(220, 233, 243, 0.45);
}

QMenu::separator {
    height: 1px;
    background: rgba(149, 223, 255, 0.12);
    margin: 6px 8px;
}

#dangerButton {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #c94a61,
        stop: 0.5 #ff6b8d,
        stop: 1 #ffadc0
    );
    color: white;
    border: 1px solid rgba(255, 232, 237, 0.80);
    border-radius: 16px;
    padding: 12px 20px;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
}

#dangerButton:hover {
    border: 1px solid rgba(255, 245, 248, 0.94);
}

#dangerButton:disabled {
    background: rgba(110, 124, 137, 0.28);
    color: rgba(230, 236, 241, 0.52);
    border: 1px solid rgba(170, 185, 200, 0.10);
}

#secondaryButton {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(13, 26, 42, 0.98),
        stop: 1 rgba(8, 18, 30, 0.99)
    );
    border: 1px solid rgba(155, 220, 255, 0.34);
    border-radius: 14px;
    min-height: 20px;
    padding: 10px 15px;
    color: #eef5fb;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
}

#secondaryButton:hover {
    border: 1px solid rgba(155, 226, 255, 0.56);
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(19, 39, 62, 0.99),
        stop: 1 rgba(10, 24, 40, 1.0)
    );
}

#secondaryButton:pressed,
#secondaryButton[flashActive="true"] {
    border: 1px solid rgba(194, 241, 255, 0.84);
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(48, 116, 160, 0.99),
        stop: 1 rgba(66, 145, 196, 0.99)
    );
    color: #ffffff;
}

#secondaryButton[toggleControl="true"]:checked {
    border: 1px solid rgba(177, 235, 255, 0.40);
    color: #ffffff;
}

#secondaryButton[toggleControl="true"]:checked:hover {
    border: 1px solid rgba(222, 247, 255, 0.50);
}

#secondaryButton[toggleControl="true"]:checked[text="Compact On"],
#secondaryButton[toggleControl="true"]:checked[text="Compact"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(46, 112, 148, 0.99),
        stop: 1 rgba(73, 167, 232, 0.99)
    );
    border: 1px solid rgba(188, 234, 255, 0.58);
}

#secondaryButton[toggleControl="true"]:checked[text="Low Overhead On"],
#secondaryButton[toggleControl="true"]:checked[text="Low Overhead"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(44, 119, 101, 0.99),
        stop: 1 rgba(71, 184, 141, 0.99)
    );
    border: 1px solid rgba(191, 247, 219, 0.56);
}

#secondaryButton[accentAction="true"] {
    border: 1px solid rgba(210, 247, 255, 0.84);
}

#secondaryButton[refreshProfile="high"] {
    border: 1px solid rgba(255, 219, 219, 0.92);
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(214, 67, 78, 0.99),
        stop: 1 rgba(255, 129, 142, 0.99)
    );
}

#secondaryButton[refreshProfile="normal"] {
    border: 1px solid rgba(207, 247, 255, 0.92);
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(62, 137, 198, 0.99),
        stop: 1 rgba(106, 204, 255, 0.99)
    );
}

#secondaryButton[refreshProfile="low"] {
    border: 1px solid rgba(255, 239, 188, 0.92);
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(191, 133, 31, 0.99),
        stop: 1 rgba(255, 190, 68, 0.99)
    );
}

#secondaryButton[refreshProfile="paused"] {
    border: 1px solid rgba(167, 179, 192, 0.34);
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(58, 66, 77, 0.98),
        stop: 1 rgba(90, 100, 111, 0.98)
    );
}

#secondaryButton[menuControl="true"] {
    padding-right: 24px;
}

#secondaryButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: 10px;
    width: 10px;
    height: 10px;
}

#statusLabel {
    color: #ffffff;
    padding-left: 2px;
    font-size: 13px;
    font-weight: 600;
}

QLabel {
    color: #edf4fa;
    background: transparent;
}

QStatusBar {
    background-color: rgba(3, 5, 8, 0.98);
    border-top: 1px solid rgba(149, 223, 255, 0.12);
}

#statusBarLabel {
    color: #ffffff;
    padding: 3px 6px;
    font-weight: 600;
}

#adminStatusBadge {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(176, 105, 25, 0.99),
        stop: 1 rgba(255, 175, 50, 0.99)
    );
    color: #fff7ea;
    border: 1px solid rgba(255, 241, 205, 0.90);
    border-radius: 10px;
    padding: 4px 10px;
    margin-right: 8px;
    font-family: "Bahnschrift SemiBold", "Segoe UI Variable Display", "Segoe UI";
}

QScrollBar:vertical {
    background: rgba(4, 6, 9, 0.52);
    width: 12px;
    margin: 6px 2px 6px 2px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: rgba(114, 198, 240, 0.34);
    min-height: 34px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(145, 220, 255, 0.50);
}

QScrollBar:horizontal {
    background: rgba(4, 6, 9, 0.52);
    height: 12px;
    margin: 2px 6px 2px 6px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: rgba(114, 198, 240, 0.34);
    min-width: 34px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(145, 220, 255, 0.50);
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
}
